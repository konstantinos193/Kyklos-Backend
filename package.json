{
  "name": "kyklos-backend",
  "version": "1.0.0",
  "description": "Backend API for ΚΥΚΛΟΣ Φροντιστήριο",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nodemon --watch src --ext ts --exec \"swc src -d dist --strip-leading-paths && node -r dotenv/config dist/main.js\"",
    "typecheck": "tsc --noEmit",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "bash ./test/run-e2e.sh",
    "test:e2e:http": "bash ./test/run-e2e.sh http",
    "test:e2e:browser": "bash ./test/run-e2e.sh browser",
    "test:e2e:down": "bash ./test/run-e2e.sh down",
    "create-admin": "node scripts/create-admin.js",
    "reset-db": "node scripts/reset-database.js",
    "seed-epityxontes": "node scripts/seed-epityxontes.js"
  },
  "keywords": [
    "api",
    "blog",
    "education",
    "tutoring",
    "nodejs",
    "express"
  ],
  "author": "ΚΥΚΛΟΣ Εκπαίδευση",
  "license": "UNLICENSED",
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@types/cookie-parser": "^1.4.10",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-cache-controller": "^1.1.0",
    "express-http-context": "^2.0.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "^6.2.108",
    "react-pdf": "^10.4.1",
    "read-excel-file": "^9.3.10",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/passport-jwt": "^4.0.1",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.17.0"
}
