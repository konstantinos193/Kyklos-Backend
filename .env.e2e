# E2E test environment - fully isolated from production.
# MongoDB points at the local container, NEVER at Atlas.
PORT=5000
NODE_ENV=production

FRONTEND_URL=http://frontend:8765
CORS_ORIGINS=http://localhost:8765,http://frontend:8765,http://localhost:3000

# Local Mongo container (isolated test database)
MONGODB_URI=mongodb://e2eroot:e2epass@mongodb:27017/kyklos_e2e?authSource=admin
MONGODB_DB_NAME=kyklos_e2e

# Mongo container bootstrap
MONGO_USERNAME=e2eroot
MONGO_PASSWORD=e2epass

# Redis via serverless-redis-http, which speaks the Upstash REST protocol the
# CacheService actually implements. A raw redis:// URL here is silently useless.
REDIS_PASSWORD=e2eredispass
UPSTASH_REDIS_REST_URL=http://srh:80
UPSTASH_REDIS_REST_TOKEN=e2e_srh_token

JWT_SECRET=e2e_test_secret_2f8a9c1d4b6e0f37a5c8d2e9b1f4a7c3d6e0b9f2a5c8d1e4b7f0a3c6d9e2b5f8

# Mailpit catches SMTP so email paths are genuinely exercised
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USER=e2e@kyklos.test
EMAIL_PASS=e2epassword
EMAIL_FROM=e2e@kyklos.test
CONTACT_EMAIL=contact@kyklos.test

CLOUDINARY_CLOUD_NAME=dkj5wm9fa
CLOUDINARY_API_KEY=767317578998922
CLOUDINARY_API_SECRET=J26OcI6R8FTycK5qd_7o26H2n14

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Production defaults are 10 and 20. Raised here because the whole suite runs
# from one container address and makes many deliberate auth failures; the limiter
# itself is verified separately by 12-ratelimit.e2e.mjs, which drives past these.
AUTH_RATE_LIMIT_MAX=100
PUBLIC_WRITE_RATE_LIMIT_MAX=200
