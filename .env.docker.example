# Docker Environment Configuration for Blue-Green Deployment
#
# The template. The real file is .env.docker, which lives on the deploy host and
# is NOT tracked - it used to be, and GitHub's secret scanner found the live
# Atlas URI, the JWT secret and the Redis password sitting in a public
# repository. Copy this next to it and fill in the values from the password
# store; never commit the result.
#
#   cp .env.docker.example .env.docker   # then edit
#
# Every value marked REPLACE_ME has to be set for the stack to come up.

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend URL
FRONTEND_URL=https://kyklos-frontend.vercel.app

# MongoDB (Atlas - Production)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kyklos_db?retryWrites=true&w=majority
MONGODB_DB_NAME=kyklos_db

# Redis (In-house Docker)
REDIS_PASSWORD=REPLACE_ME
REDIS_URL=redis://:REPLACE_ME@redis:6379
UPSTASH_REDIS_REST_URL=redis://:REPLACE_ME@redis:6379
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# JWT Secret - 64 random bytes.
# Rotating this invalidates every issued admin and student token, so everyone
# is signed out once on deploy. That is expected and is the point.
# This file is tracked by git: move the value to a real secret store (or an
# untracked env file on the host) and rotate it again once you do.
JWT_SECRET=REPLACE_ME_64_RANDOM_BYTES

# Uploads.
#
# Files are stored on this host under public/uploads (the public-files volume)
# and served from /public/uploads. This is the origin a browser reaches that
# path on, and it is baked into the URL saved in MongoDB - point it at the
# public API hostname, never at localhost or a container name.
PUBLIC_ASSET_BASE_URL=https://api.kyklosedu.gr

# Email Configuration (update with your production email settings)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-production-email@gmail.com
EMAIL_PASS=REPLACE_ME
EMAIL_FROM=your-production-email@gmail.com
CONTACT_EMAIL=contact@your-domain.com

# Rate Limiting (production values)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
