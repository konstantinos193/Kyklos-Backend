# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/kyklos_db

# Redis Cache (for production use Redis Cloud or Upstash)
# For local development: redis://localhost:6379
# For Render: Use Redis Cloud (free tier available)
REDIS_URL=redis://localhost:6379
REDISCLOUD_URL=rediss://username:password@host:port

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Uploads
#
# Images and files are stored on this host under public/uploads and served from
# /public/uploads. Nothing is re-encoded per request: each upload is resized to
# 1600px, stripped of metadata and written once as AVIF (photos) or WebP
# (screenshots, transparency, animation).
#
# The URL written into MongoDB is built from this base, so it has to be the
# origin the browser reaches this API on - not localhost, in production.
PUBLIC_ASSET_BASE_URL=http://localhost:5000

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=grkyklos-@hotmail.gr
EMAIL_PASS=your-app-password
EMAIL_FROM=grkyklos-@hotmail.gr
CONTACT_EMAIL=grkyklos-@hotmail.gr

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
